{
  "name": "BUYASOUL Workbench",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3000, 3001, 3457, 4000, 20128],
  "portsAttributes": {
    "3000": { "label": "Workbench", "onAutoForward": "openPreview" },
    "3001": { "label": "GSK MCP" },
    "3457": { "label": "CPL" },
    "4000": { "label": "Scribe" },
    "20128": { "label": "OmniRoute" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start-workbench.sh",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", ".devcontainer/README.md"] },
    "vscode": { "extensions": ["dbaeumer.vscode-eslint"] }
  }
}
